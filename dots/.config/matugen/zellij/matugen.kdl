            emphasis_1 "{{colors.primary.default.hex}}"
            emphasis_2 "{{colors.secondary.default.hex}}"
            emphasis_3 "{{colors.on_surface_variant.default.hex}}"
        }
        table_cell_unselected {
            base "{{colors.on_surface.default.hex}}"
            background "{{colors.surface_container.default.hex}}"
            emphasis_0 "{{colors.tertiary.default.hex}}"
            emphasis_1 "{{colors.primary.default.hex}}"
            emphasis_2 "{{colors.secondary.default.hex}}"
            emphasis_3 "{{colors.on_surface_variant.default.hex}}"
        }
        list_selected {
            base "{{colors.on_secondary_container.default.hex}}"
            background "{{colors.secondary_container.default.hex}}"
            emphasis_0 "{{colors.tertiary.default.hex}}"
            emphasis_1 "{{colors.primary.default.hex}}"
            emphasis_2 "{{colors.secondary.default.hex}}"
            emphasis_3 "{{colors.on_surface_variant.default.hex}}"
        }
        list_unselected {
            base "{{colors.on_surface.default.hex}}"
            background "{{colors.surface_container.default.hex}}"
            emphasis_0 "{{colors.tertiary.default.hex}}"
            emphasis_1 "{{colors.primary.default.hex}}"
            emphasis_2 "{{colors.secondary.default.hex}}"
            emphasis_3 "{{colors.on_surface_variant.default.hex}}"
        }
        frame_selected {
            base "{{colors.primary.default.hex}}"
            background 0
            emphasis_0 "{{colors.tertiary.default.hex}}"
            emphasis_1 "{{colors.secondary.default.hex}}"
            emphasis_2 "{{colors.primary.default.hex}}"
            emphasis_3 0
        }
        frame_highlight {
            base "{{colors.tertiary.default.hex}}"
